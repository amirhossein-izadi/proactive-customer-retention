# Python
__pycache__/
*.py[oc]
*.egg-info
build/
dist/
wheels/
.venv
*.egg-link

# Tests
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/

# Model artifacts (generated by training/bundling — reproduce via `retention train` + `retention bundle`)
models/**/*.pkl
models/**/*.json
models/**/*.md
artifacts/oof_predictions/
artifacts/metrics/
artifacts/rankings/
artifacts/plots/
artifacts/runs/
catboost_info/

# Data (large files — tracked via DVC, not git)
data/raw/*.csv
data/interim/
data/processed/
data/snapshots/
data/*.parquet

# DVC (cache is local; lock file MUST be committed)
.dvc/cache/
.dvc/tmp/

# MLflow (local tracking — use remote server in production)
mlruns/
mlflow.db
mlflow.db-*
 MlflowTrash/

# Reports (generated — reproduce via `retention evaluate` / `retention rank`)
reports/model_comparison.csv
reports/final_ranking.csv
reports/ablation_results.csv
reports/executive_summary.md
reports/limitations.md
reports/final_report.md

# Jupyter
.ipynb_checkpoints/
notebooks/*.ipynb_checkpoints/

# Archives (regenerate with Compress-Archive — never commit binaries)
*.zip
*.tar.gz

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
.opencode/

# Env
.env
.env.local
