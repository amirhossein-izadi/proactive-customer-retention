# Python
__pycache__/
*.py[oc]
*.egg-info
build/
dist/
wheels/
.venv
*.egg-link

# Tests
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/

# Optuna study databases (binary SQLite, regenerate via `retention tune`;
# keep *_best.json and *_trials.csv as records)
artifacts/optuna/*.db
artifacts/optuna/*.db-journal

# Model artifacts — champion bundle IS committed (deployable, ~1.5MB).
# Candidates/registry drafts stay out of git.
models/candidates/
models/registry/
models/champion_bundle_final/
catboost_info/

# Generated artifacts (reproducible via `retention run`)
artifacts/oof_predictions/
artifacts/metrics/
artifacts/rankings/
artifacts/plots/
artifacts/runs/

# Data (large files — tracked via DVC, not git)
data/raw/*.csv
data/interim/
data/processed/
data/snapshots/
data/*.parquet

# DVC (cache is local; lock file MUST be committed)
.dvc/cache/
.dvc/tmp/

# MLflow (local tracking — use remote server in production)
mlruns/
mlflow.db
mlflow.db-*
 MlflowTrash/

# Reports (generated — reproduce via `retention evaluate` / `retention rank`)
reports/model_comparison.csv
reports/final_ranking.csv
reports/ablation_results.csv
reports/executive_summary.md
reports/limitations.md
reports/final_report.md

# Jupyter
.ipynb_checkpoints/
notebooks/*.ipynb_checkpoints/

# Archives (regenerate with Compress-Archive — never commit binaries)
*.zip
*.tar.gz

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
.opencode/

# Env
.env
.env.local
